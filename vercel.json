{
  "rewrites": [
    { "source": "/dave", "destination": "/dave.html" },
    { "source": "/tasks", "destination": "/tasks/index.html" },
    { "source": "/tasks/:path*", "destination": "/tasks/index.html" },
    { "source": "/projects", "destination": "/projects/index.html" },
    { "source": "/projects/:path*", "destination": "/projects/index.html" },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "fbcorp.ai" }],
      "destination": "/fbcorp-landing/index.html"
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "fbcorp.ai" }],
      "destination": "/fbcorp-landing/index.html"
    }
  ]
}
{
  "rewrites": [
    { "source": "/estimating", "destination": "https://estimating.drewcodehq.com" },
    { "source": "/estimating/:path*", "destination": "https://estimating.drewcodehq.com/:path*" }
  ]
}
